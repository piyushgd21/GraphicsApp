#version 450

layout(local_size_x = 16, local_size_y = 1, local_size_z = 1) in;

struct GpuCameraIntrinsics
{
	int width;
	int height;
	float fx;
	float fy;
	float cx;
	float cy;
	float k1;
	float k2;
	float p1;
	float p2;
};

struct GpuCameraPose
{
	vec4 position;
	vec4 forward;
	vec4 up;
	vec4 right;
};

layout(set = 0, binding = 0, std430) readonly buffer IntrinsicsBuffer
{
	GpuCameraIntrinsics values[];
} intrinsics;

layout(set = 0, binding = 1, std430) readonly buffer PosesBuffer
{
	GpuCameraPose values[];
} poses;

layout(set = 0, binding = 2, std430) readonly buffer SampleValues
{
	float values[];
} samples;

layout(set = 0, binding = 3, std430) readonly buffer CameraIndices
{
	uint values[];
} cameraIndices;

layout(set = 0, binding = 4, std430) writeonly buffer OutputBuffer
{
	vec4 values[];
} outputBuffer;

vec3 UnprojectPixelCpuEquivalent(
	GpuCameraPose camera,
	GpuCameraIntrinsics intrinsic,
	float x,
	float y,
	float depth)
{
	float targetX = (x + 0.5 - intrinsic.cx) / intrinsic.fx;
	float targetY = (y + 0.5 - intrinsic.cy) / intrinsic.fy;
	float localX = targetX;
	float localY = targetY;

	for (int iteration = 0; iteration < 5; ++iteration)
	{
		float radiusSquared = (localX * localX) + (localY * localY);
		float radial = 1.0 + (intrinsic.k1 * radiusSquared) + (intrinsic.k2 * radiusSquared * radiusSquared);
		float distortedX = (localX * radial) + (2.0 * intrinsic.p1 * localX * localY) +
			(intrinsic.p2 * (radiusSquared + (2.0 * localX * localX)));
		float distortedY = (localY * radial) + (intrinsic.p1 * (radiusSquared + (2.0 * localY * localY))) +
			(2.0 * intrinsic.p2 * localX * localY);
		localX += targetX - distortedX;
		localY += targetY - distortedY;
	}

	return camera.position.xyz + (camera.right.xyz * (localX * depth)) -
		(camera.up.xyz * (localY * depth)) + (camera.forward.xyz * depth);
}

void main()
{
	uint i = gl_GlobalInvocationID.x;
	if (i >= 16u)
		return;

	uint cameraIndex = cameraIndices.values[i];
	float x = samples.values[i * 4u + 0u];
	float y = samples.values[i * 4u + 1u];
	float depth = samples.values[i * 4u + 2u];
	vec3 world = UnprojectPixelCpuEquivalent(poses.values[cameraIndex], intrinsics.values[cameraIndex], x, y, depth);
	outputBuffer.values[i] = vec4(world, 0.0);
}
