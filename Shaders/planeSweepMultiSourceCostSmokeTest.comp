#version 450

layout(local_size_x = 10, local_size_y = 1, local_size_z = 1) in;

struct GpuCameraIntrinsics { int width; int height; float fx; float fy; float cx; float cy; float k1; float k2; float p1; float p2; };
struct GpuCameraPose { vec4 position; vec4 forward; vec4 up; vec4 right; };

layout(set = 0, binding = 0) uniform sampler2D referenceImage;
layout(set = 0, binding = 1) uniform sampler2D referenceMask;
layout(set = 0, binding = 2) uniform sampler2D sourceImages[8];
layout(set = 0, binding = 3) uniform sampler2D sourceMasks[8];
layout(set = 0, binding = 4, std430) readonly buffer IntrinsicsBuffer { GpuCameraIntrinsics values[]; } intrinsics;
layout(set = 0, binding = 5, std430) readonly buffer PosesBuffer { GpuCameraPose values[]; } poses;
layout(set = 0, binding = 6, std430) readonly buffer CaseValues { float values[]; } cases;
layout(set = 0, binding = 7, std430) readonly buffer CaseParameters { uint values[]; } caseParameters;
layout(set = 0, binding = 8, std430) readonly buffer SourceMetadata { uint values[]; } sourceMetadata;
layout(set = 0, binding = 9, std430) writeonly buffer ValidityOutput { uint values[]; } validityOutput;
layout(set = 0, binding = 10, std430) writeonly buffer CostOutput { float values[]; } costOutput;
layout(set = 0, binding = 11, std430) writeonly buffer ValidSourceViewsOutput { uint values[]; } validViewsOutput;
layout(set = 0, binding = 12, std430) writeonly buffer MinimumSamplesOutput { uint values[]; } minimumSamplesOutput;
layout(set = 0, binding = 13, std430) writeonly buffer SampleCountsOutput { uint values[]; } sampleCountsOutput;
layout(set = 0, binding = 14, std430) writeonly buffer SourceAverageCostsOutput { float values[]; } sourceAverageCostsOutput;

bool IsFiniteFloat(float value) { return !isnan(value) && !isinf(value); }

bool SampleBilinearCpuEquivalent(sampler2D image, vec2 pixel, out vec4 color)
{
	ivec2 size = textureSize(image, 0);
	if (size.x <= 0 || size.y <= 0 || pixel.x < 0.0 || pixel.y < 0.0 || pixel.x > float(size.x - 1) || pixel.y > float(size.y - 1)) { color = vec4(0.0); return false; }
	int x0 = int(floor(pixel.x)); int y0 = int(floor(pixel.y));
	int x1 = min(size.x - 1, x0 + 1); int y1 = min(size.y - 1, y0 + 1);
	float tx = pixel.x - float(x0); float ty = pixel.y - float(y0);
	vec4 c00 = texelFetch(image, ivec2(x0, y0), 0); vec4 c10 = texelFetch(image, ivec2(x1, y0), 0);
	vec4 c01 = texelFetch(image, ivec2(x0, y1), 0); vec4 c11 = texelFetch(image, ivec2(x1, y1), 0);
	vec4 top = (c00 * (1.0 - tx)) + (c10 * tx); vec4 bottom = (c01 * (1.0 - tx)) + (c11 * tx);
	color = (top * (1.0 - ty)) + (bottom * ty); return true;
}

bool SamplePlaneSweepPixelCpuEquivalent(sampler2D imageTexture, sampler2D maskTexture, vec2 pixel, bool hasMask, bool maskUsesAlpha, out vec4 color)
{
	if (!SampleBilinearCpuEquivalent(imageTexture, pixel, color)) return false;
	if (!hasMask) return true;
	ivec2 imageSize = textureSize(imageTexture, 0); ivec2 maskSize = textureSize(maskTexture, 0);
	float imageWidth = float(max(1, imageSize.x - 1)); float imageHeight = float(max(1, imageSize.y - 1));
	float maskWidth = float(max(1, maskSize.x - 1)); float maskHeight = float(max(1, maskSize.y - 1));
	vec2 maskPixel = vec2((pixel.x / imageWidth) * maskWidth, (pixel.y / imageHeight) * maskHeight);
	vec4 maskColor; if (!SampleBilinearCpuEquivalent(maskTexture, maskPixel, maskColor)) return false;
	color.a = maskUsesAlpha ? maskColor.a : (maskColor.r * 0.299) + (maskColor.g * 0.587) + (maskColor.b * 0.114);
	return true;
}

bool SampleSourcePlaneSweepPixel(uint sourceIndex, vec2 pixel, bool hasMask, bool maskUsesAlpha, out vec4 color)
{
	switch (sourceIndex)
	{
		case 0u: return SamplePlaneSweepPixelCpuEquivalent(sourceImages[0], sourceMasks[0], pixel, hasMask, maskUsesAlpha, color);
		case 1u: return SamplePlaneSweepPixelCpuEquivalent(sourceImages[1], sourceMasks[1], pixel, hasMask, maskUsesAlpha, color);
		case 2u: return SamplePlaneSweepPixelCpuEquivalent(sourceImages[2], sourceMasks[2], pixel, hasMask, maskUsesAlpha, color);
		case 3u: return SamplePlaneSweepPixelCpuEquivalent(sourceImages[3], sourceMasks[3], pixel, hasMask, maskUsesAlpha, color);
		case 4u: return SamplePlaneSweepPixelCpuEquivalent(sourceImages[4], sourceMasks[4], pixel, hasMask, maskUsesAlpha, color);
		case 5u: return SamplePlaneSweepPixelCpuEquivalent(sourceImages[5], sourceMasks[5], pixel, hasMask, maskUsesAlpha, color);
		case 6u: return SamplePlaneSweepPixelCpuEquivalent(sourceImages[6], sourceMasks[6], pixel, hasMask, maskUsesAlpha, color);
		case 7u: return SamplePlaneSweepPixelCpuEquivalent(sourceImages[7], sourceMasks[7], pixel, hasMask, maskUsesAlpha, color);
		default: color = vec4(0.0); return false;
	}
}

vec3 UnprojectPixelCpuEquivalent(GpuCameraPose camera, GpuCameraIntrinsics intrinsic, float x, float y, float depth)
{
	float targetX = (x + 0.5 - intrinsic.cx) / intrinsic.fx; float targetY = (y + 0.5 - intrinsic.cy) / intrinsic.fy;
	float localX = targetX; float localY = targetY;
	for (int iteration = 0; iteration < 5; ++iteration)
	{
		float radiusSquared = (localX * localX) + (localY * localY);
		float radial = 1.0 + (intrinsic.k1 * radiusSquared) + (intrinsic.k2 * radiusSquared * radiusSquared);
		float distortedX = (localX * radial) + (2.0 * intrinsic.p1 * localX * localY) + (intrinsic.p2 * (radiusSquared + (2.0 * localX * localX)));
		float distortedY = (localY * radial) + (intrinsic.p1 * (radiusSquared + (2.0 * localY * localY))) + (2.0 * intrinsic.p2 * localX * localY);
		localX += targetX - distortedX; localY += targetY - distortedY;
	}
	return camera.position.xyz + (camera.right.xyz * (localX * depth)) - (camera.up.xyz * (localY * depth)) + (camera.forward.xyz * depth);
}

bool ProjectPointCpuEquivalent(GpuCameraPose camera, GpuCameraIntrinsics intrinsic, vec3 point, out float x, out float y, out float depth)
{
	precise vec3 offset = point - camera.position.xyz;
	precise float depthXY = (offset.x * camera.forward.x) + (offset.y * camera.forward.y); depth = depthXY + (offset.z * camera.forward.z);
	if (depth <= 0.0001) { x = 0.0; y = 0.0; return false; }
	precise float localXNumeratorXY = (offset.x * camera.right.x) + (offset.y * camera.right.y);
	precise float localX = (localXNumeratorXY + (offset.z * camera.right.z)) / depth;
	precise float localYNumeratorXY = (offset.x * camera.up.x) + (offset.y * camera.up.y);
	precise float localYNumerator = localYNumeratorXY + (offset.z * camera.up.z); precise float localY = (-localYNumerator) / depth;
	precise float radiusSquared = (localX * localX) + (localY * localY);
	precise float radial = 1.0 + (intrinsic.k1 * radiusSquared) + (intrinsic.k2 * radiusSquared * radiusSquared);
	precise float distortedX = (localX * radial) + (2.0 * intrinsic.p1 * localX * localY) + (intrinsic.p2 * (radiusSquared + (2.0 * localX * localX)));
	precise float distortedY = (localY * radial) + (intrinsic.p1 * (radiusSquared + (2.0 * localY * localY))) + (2.0 * intrinsic.p2 * localX * localY);
	x = (intrinsic.fx * distortedX) + intrinsic.cx; y = (intrinsic.fy * distortedY) + intrinsic.cy;
	return IsFiniteFloat(x) && IsFiniteFloat(y) && IsFiniteFloat(depth);
}

bool ComputePlaneCostCpuEquivalent(uint caseIndex, out float cost, out uint validSourceViews, out uint minimumOpaqueSamples)
{
	uint floatOffset = caseIndex * 8u; uint uintOffset = caseIndex * 4u;
	float x = cases.values[floatOffset]; float y = cases.values[floatOffset + 1u]; float depth = cases.values[floatOffset + 2u];
	float alphaThreshold = cases.values[floatOffset + 3u]; float minimumOpaquePatchRatio = cases.values[floatOffset + 4u];
	int patchRadius = int(caseParameters.values[uintOffset]); uint sourceCount = caseParameters.values[uintOffset + 1u];
	int minValidSourceViews = int(caseParameters.values[uintOffset + 2u]);
	for (uint sourceIndex = 0u; sourceIndex < 8u; ++sourceIndex)
	{
		uint diagnosticIndex = caseIndex * 8u + sourceIndex;
		sampleCountsOutput.values[diagnosticIndex] = 0u;
		sourceAverageCostsOutput.values[diagnosticIndex] = 0.0;
	}
	int patchWidth = (patchRadius * 2) + 1; int patchArea = patchWidth * patchWidth;
	minimumOpaqueSamples = uint(max(1, int(ceil(float(patchArea) * minimumOpaquePatchRatio))));
	float totalCost = 0.0; validSourceViews = 0u;
	for (uint sourceIndex = 0u; sourceIndex < sourceCount; ++sourceIndex)
	{
		float sourceCost = 0.0; int sampleCount = 0;
		for (int patchY = -patchRadius; patchY <= patchRadius; ++patchY)
		{
			for (int patchX = -patchRadius; patchX <= patchRadius; ++patchX)
			{
				float referenceX = x + float(patchX); float referenceY = y + float(patchY); vec4 referenceColor;
				if (!SamplePlaneSweepPixelCpuEquivalent(referenceImage, referenceMask, vec2(referenceX, referenceY), false, false, referenceColor)) continue;
				if (referenceColor.a <= alphaThreshold) continue;
				vec3 point = UnprojectPixelCpuEquivalent(poses.values[0], intrinsics.values[0], referenceX, referenceY, depth);
				uint cameraIndex = sourceIndex + 1u; float sourceX; float sourceY; float sourceDepth;
				if (!ProjectPointCpuEquivalent(poses.values[cameraIndex], intrinsics.values[cameraIndex], point, sourceX, sourceY, sourceDepth)) continue;
				ivec2 sourceSize = textureSize(sourceImages[0], 0);
				if (!(sourceX >= 0.0 && sourceY >= 0.0 && sourceX < float(sourceSize.x) && sourceY < float(sourceSize.y))) continue;
				bool hasMask = sourceMetadata.values[sourceIndex * 2u] != 0u;
				bool maskUsesAlpha = sourceMetadata.values[sourceIndex * 2u + 1u] != 0u; vec4 sourceColor;
				if (!SampleSourcePlaneSweepPixel(sourceIndex, vec2(sourceX, sourceY), hasMask, maskUsesAlpha, sourceColor)) continue;
				if (sourceColor.a <= alphaThreshold) continue;
				sourceCost += (abs(referenceColor.r - sourceColor.r) + abs(referenceColor.g - sourceColor.g) + abs(referenceColor.b - sourceColor.b)) / 3.0;
				++sampleCount;
			}
		}
		uint diagnosticIndex = caseIndex * 8u + sourceIndex;
		sampleCountsOutput.values[diagnosticIndex] = uint(sampleCount);
		sourceAverageCostsOutput.values[diagnosticIndex] = 0.0;
		if (sampleCount >= int(minimumOpaqueSamples))
		{
			float sourceAverage = sourceCost / float(sampleCount);
			sourceAverageCostsOutput.values[diagnosticIndex] = sourceAverage;
			totalCost += sourceAverage;
			++validSourceViews;
		}
	}
	if (int(validSourceViews) < minValidSourceViews) { cost = 0.0; return false; }
	cost = totalCost / float(validSourceViews); return IsFiniteFloat(cost);
}

void main()
{
	uint i = gl_GlobalInvocationID.x; if (i >= 10u) return;
	float cost; uint validSourceViews; uint minimumOpaqueSamples;
	bool valid = ComputePlaneCostCpuEquivalent(i, cost, validSourceViews, minimumOpaqueSamples);
	validityOutput.values[i] = valid ? 1u : 0u; costOutput.values[i] = cost;
	validViewsOutput.values[i] = validSourceViews; minimumSamplesOutput.values[i] = minimumOpaqueSamples;
}
