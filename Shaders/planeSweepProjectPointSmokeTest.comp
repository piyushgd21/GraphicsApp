#version 450

layout(local_size_x = 16, local_size_y = 1, local_size_z = 1) in;

struct GpuCameraIntrinsics
{
	int width;
	int height;
	float fx;
	float fy;
	float cx;
	float cy;
	float k1;
	float k2;
	float p1;
	float p2;
};

struct GpuCameraPose
{
	vec4 position;
	vec4 forward;
	vec4 up;
	vec4 right;
};

layout(set = 0, binding = 0, std430) readonly buffer IntrinsicsBuffer
{
	GpuCameraIntrinsics values[];
} intrinsics;

layout(set = 0, binding = 1, std430) readonly buffer PosesBuffer
{
	GpuCameraPose values[];
} poses;

layout(set = 0, binding = 2, std430) readonly buffer PointValues
{
	float values[];
} points;

layout(set = 0, binding = 3, std430) readonly buffer CameraIndices
{
	uint values[];
} cameraIndices;

layout(set = 0, binding = 4, std430) writeonly buffer ProjectionOutput
{
	vec4 values[];
} projectionOutput;

layout(set = 0, binding = 5, std430) writeonly buffer ValidityOutput
{
	uint values[];
} validOutput;

bool IsFiniteFloat(float value)
{
	return !isnan(value) && !isinf(value);
}

bool ProjectPointCpuEquivalent(
	GpuCameraPose camera,
	GpuCameraIntrinsics intrinsic,
	vec3 point,
	out float x,
	out float y,
	out float depth)
{
	precise vec3 offset = point - camera.position.xyz;
	precise float depthXY = (offset.x * camera.forward.x) + (offset.y * camera.forward.y);
	depth = depthXY + (offset.z * camera.forward.z);
	if (depth <= 0.0001)
	{
		x = 0.0;
		y = 0.0;
		return false;
	}

	precise float localXNumeratorXY = (offset.x * camera.right.x) + (offset.y * camera.right.y);
	precise float localX = (localXNumeratorXY + (offset.z * camera.right.z)) / depth;
	precise float localYNumeratorXY = (offset.x * camera.up.x) + (offset.y * camera.up.y);
	precise float localYNumerator = localYNumeratorXY + (offset.z * camera.up.z);
	precise float localY = (-localYNumerator) / depth;
	precise float radiusSquared = (localX * localX) + (localY * localY);
	precise float radial = 1.0 + (intrinsic.k1 * radiusSquared) + (intrinsic.k2 * radiusSquared * radiusSquared);
	precise float distortedX = (localX * radial) + (2.0 * intrinsic.p1 * localX * localY) +
		(intrinsic.p2 * (radiusSquared + (2.0 * localX * localX)));
	precise float distortedY = (localY * radial) + (intrinsic.p1 * (radiusSquared + (2.0 * localY * localY))) +
		(2.0 * intrinsic.p2 * localX * localY);

	x = (intrinsic.fx * distortedX) + intrinsic.cx;
	y = (intrinsic.fy * distortedY) + intrinsic.cy;
	return IsFiniteFloat(x) && IsFiniteFloat(y) && IsFiniteFloat(depth);
}

void main()
{
	uint i = gl_GlobalInvocationID.x;
	if (i >= 16u)
		return;

	uint cameraIndex = cameraIndices.values[i];
	vec3 point = vec3(points.values[i * 4u + 0u], points.values[i * 4u + 1u], points.values[i * 4u + 2u]);
	float x;
	float y;
	float depth;
	bool valid = ProjectPointCpuEquivalent(poses.values[cameraIndex], intrinsics.values[cameraIndex], point, x, y, depth);
	projectionOutput.values[i] = vec4(x, y, depth, 0.0);
	validOutput.values[i] = valid ? 1u : 0u;
}
