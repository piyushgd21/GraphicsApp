#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer OutputBuffer
{
	float values[];
} outputBuffer;

void main()
{
	uint index = gl_GlobalInvocationID.x;

	if (index < 64)
	{
		outputBuffer.values[index] = 123.0 + float(index) * 0.25;
	}
}
