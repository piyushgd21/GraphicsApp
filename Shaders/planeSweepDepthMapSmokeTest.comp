#version 450
#extension GL_GOOGLE_include_directive : require
#include "planeSweepMatching.glsl"

void main()
{
	PlaneSweepGpuParams params = paramsBuffer.value;
	uint invocationX = gl_GlobalInvocationID.x; uint invocationY = gl_GlobalInvocationID.y;
	uint scaledX = invocationX * params.pointStep; uint scaledY = invocationY * params.pointStep;
	if (scaledX >= params.scaledWidth || scaledY >= params.scaledHeight) return;
	uint referenceWidth = uint(textureSize(referenceImage, 0).x); uint referenceHeight = uint(textureSize(referenceImage, 0).y);
	uint referenceXi = (scaledX * referenceWidth) / params.scaledWidth; uint referenceYi = (scaledY * referenceHeight) / params.scaledHeight;
	float referenceX = float(referenceXi); float referenceY = float(referenceYi); uint depthIndex = scaledY * params.scaledWidth + scaledX;
	uint sampleGridWidth = (params.scaledWidth + params.pointStep - 1u) / params.pointStep;
	uint diagnosticStride = max(100u, 10u + uint(params.patchRadius * 2 + 1) * uint(params.patchRadius * 2 + 1) * 10u);
	uint diagnosticIndex = invocationY * sampleGridWidth + invocationX; uint status = kStatusNoValidPlane; float finalDepth = 0.0;
	vec4 referenceColor; float textureStandardDeviation = 0.0; uint textureSampleCount = 0u;
	int patchWidth = params.patchRadius * 2 + 1; int patchArea = patchWidth * patchWidth;
	uint minimumOpaqueSamples = uint(max(1, int(ceil(float(patchArea) * params.minimumOpaquePatchRatio)))); uint planeCostSampleCount = 0u;
	if (!SamplePlaneSweepPixelCpuEquivalent(referenceImage, referenceMask, vec2(referenceX, referenceY), sourceMetadata.values[16] != 0u, sourceMetadata.values[17] != 0u, referenceColor) || referenceColor.a <= params.alphaThreshold)
	{
		status = kStatusReferenceInvalid;
	}
	else if (params.textureRejectionEnabled != 0u)
	{
		if (!ComputeTextureStandardDeviationCpuEquivalent(referenceX, referenceY, params.patchRadius, params.alphaThreshold, sourceMetadata.values[16] != 0u, sourceMetadata.values[17] != 0u, diagnosticIndex, textureStandardDeviation, textureSampleCount) || textureStandardDeviation < params.textureMinimumStdDev)
		{
			status = kStatusTextureRejected;
		}
		else
		{
			status = kStatusNoValidPlane;
		}
	}
	else
	{
		// Keep status in the normal search-ready state when texture rejection is disabled.
		status = kStatusNoValidPlane;
	}
	if (status == kStatusNoValidPlane)
	{
		float bestCost = kFloatMax; float secondBestCost = kFloatMax; float bestDepth = 0.0;
		int planeCount = max(2, params.planeCount);
		for (int planeIndex = 0; planeIndex < planeCount; ++planeIndex)
		{
			float t = planeCount <= 1 ? 0.0 : float(planeIndex) / float(planeCount - 1);
			float inverseDepth = params.inverseNear * (1.0 - t) + params.inverseFar * t; float depth = 1.0 / max(inverseDepth, 0.000001);
			float cost = 0.0; uint planeMinimumOpaqueSamples = 0u;
			bool hasCost = ComputePlaneCostCpuEquivalent(referenceX, referenceY, depth, cost, planeMinimumOpaqueSamples, planeCostSampleCount);
			minimumOpaqueSamples = planeMinimumOpaqueSamples;
#if defined(GRAPHICSAPP_ENABLE_PHASE_2PB_GPU_TRACE)
			if (sourceMetadata.values[18] != 0u && depthIndex == sourceMetadata.values[19] && referenceXi == sourceMetadata.values[20] && referenceYi == sourceMetadata.values[21])
			{
				uint patchWidth = uint(params.patchRadius * 2 + 1);
				uint recordsPerPlane = 1u + params.sourceCount * patchWidth * patchWidth;
				uint traceBase = uint(planeIndex) * recordsPerPlane * 16u;
				traceOutput.values[traceBase] = 0u;
				traceOutput.values[traceBase + 1u] = uint(planeIndex);
				traceOutput.values[traceBase + 2u] = floatBitsToUint(depth);
				traceOutput.values[traceBase + 3u] = hasCost ? 1u : 0u;
				traceOutput.values[traceBase + 4u] = floatBitsToUint(cost);
				traceOutput.values[traceBase + 5u] = planeMinimumOpaqueSamples;
				traceOutput.values[traceBase + 6u] = planeCostSampleCount;
			}
#endif
			if (hasCost && cost < bestCost) { secondBestCost = bestCost; bestCost = cost; bestDepth = depth; }
			else if (hasCost && IsFiniteFloat(cost) && cost < secondBestCost) secondBestCost = cost;
		}
		if (bestDepth > 0.0)
		{
			if (bestCost > params.costThreshold) status = kStatusCostRejected;
			else if (params.confidenceEnabled != 0u && (!IsFiniteFloat(secondBestCost) || (secondBestCost - bestCost) < max(0.0, params.confidenceMinimumDifference))) status = kStatusConfidenceRejected;
			else { status = kStatusAccepted; finalDepth = bestDepth; }
		}
	}
	depthOutput.values[depthIndex] = finalDepth;
	uint base = diagnosticIndex * 7u;
	mappingOutput.values[base] = invocationX; mappingOutput.values[base + 1u] = invocationY;
	mappingOutput.values[base + 2u] = scaledX; mappingOutput.values[base + 3u] = scaledY;
	mappingOutput.values[base + 4u] = referenceXi; mappingOutput.values[base + 5u] = referenceYi; mappingOutput.values[base + 6u] = depthIndex;
	statusOutput.values[diagnosticIndex] = status;
	if (textureSampleCount == 0u) textureStdDevOutput.values[diagnosticIndex * diagnosticStride + 9u] = floatBitsToUint(textureStandardDeviation);
	textureSampleCountOutput.values[diagnosticIndex] = textureSampleCount;
	minimumOpaqueSamplesOutput.values[diagnosticIndex] = minimumOpaqueSamples;
	planeCostSampleCountOutput.values[diagnosticIndex] = planeCostSampleCount;
}
